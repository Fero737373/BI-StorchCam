{
  "app": {
    "name": "BI-StorchCam",
    "language": "de",
    "timezone": "Europe/Berlin",
    "cache_dir": "~/.cache/BI-StorchCam",
    "config_schema_version": 4
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "max_request_bytes": 262144,
    "admin_session_minutes": 30
  },
  "kiosk": {
    "enabled": true,
    "browser": "auto",
    "profile_dir": "",
    "disable_screensaver": true,
    "use_gpu": true,
    "browser_restart_seconds": 3,
    "browser_restart_max_seconds": 60,
    "browser_stable_seconds": 30,
    "browser_max_failures": 8,
    "log_file": "~/.cache/BI-StorchCam/chromium.log",
    "log_max_bytes": 2097152,
    "log_backups": 3,
    "extra_flags": []
  },
  "screen": {
    "hardware_profile": "generic",
    "output": "auto",
    "rotation": "none",
    "touch_device": "",
    "touch_matrix": ""
  },
  "location": {
    "label": "Bielefeld",
    "latitude": 52.0302,
    "longitude": 8.5325
  },
  "stream": {
    "url": "",
    "muted": true,
    "autoplay": true
  },
  "admin": {
    "pin_hash": ""
  },
  "ui": {
    "theme": "dark",
    "layout_profile": "auto",
    "clock": { "enabled": true },
    "weather": { "enabled": true },
    "radar": {
      "enabled": true,
      "width": 280,
      "height": 190,
      "zoom": 12,
      "opacity": 0.92
    },
    "transit": { "enabled": false },
    "system": { "enabled": false }
  },
  "weather": {
    "provider": "openmeteo",
    "refresh_seconds": 300,
    "forecast_hours": 8,
    "rain_mm_threshold": 0.1,
    "rain_probability_threshold": 45
  },
  "transit": {
    "provider": "vrr",
    "refresh_seconds": 60,
    "default_max_rows": 2,
    "target_len": 16,
    "stops": []
  },
  "radar": {
    "provider": "rainviewer",
    "refresh_seconds": 300
  },
  "logging": {
    "level": "INFO",
    "max_bytes": 2097152,
    "backups": 3
  }
}
